# start - specific to this repo
DB_CONNECTION=mongodb
DB_DSN=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/sample_mflix?retryWrites=true&w=majority
DB_DATABASE=sample_mflix

# Voyage AI API Key for generating embeddings
# https://dashboard.voyageai.com/organization/api-keys
VOYAGE_AI_API_KEY=YOUR_API_KEY_HERE

# Vector search configuration
VECTOR_DIMENSIONS=512
VECTOR_SIMILARITY=cosine

# generate only 100 embeddings to keep token usage low
EMBEDDING_SAFETY_LIMIT=100
# end - specific to this repo

APP_NAME=devrel-laravel-v-search-2025
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# below changes because MDB does not support 'database' for these
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
